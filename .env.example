# Rename this file to ".env" and fill in your real values. Never commit ".env" to git.

# Discord Developer Portal -> your app -> Bot -> Token
DISCORD_TOKEN=your_bot_token_here

# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=your_application_id_here

# Right-click your server in Discord (Developer Mode on) -> Copy Server ID
GUILD_ID=your_server_id_here

# From the HenrikDev API Discord bot (free Basic key)
HENRIK_API_KEY=your_henrikdev_api_key_here

# Channel where members upload clips + their real rank (make this private:
# deny @everyone, allow only the bot's role and your admin role)
UPLOAD_CHANNEL_ID=your_private_upload_channel_id_here

# Public channel where the bot posts each day's anonymized clips for guessing
GUESS_CHANNEL_ID=your_guess_the_rank_channel_id_here